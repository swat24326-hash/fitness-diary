{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      { "command": "node .cursor/hooks/guard-shell.mjs", "timeout": 20 }
    ],
    "beforeSubmitPrompt": [
      { "command": "node .cursor/hooks/guard-prompt-secrets.mjs", "timeout": 20 }
    ],
    "beforeReadFile": [
      { "command": "node .cursor/hooks/guard-read-secrets.mjs", "timeout": 20 }
    ],
    "afterFileEdit": [
      { "command": "node .cursor/hooks/track-edit.mjs", "timeout": 20 }
    ],
    "stop": [
      { "command": "node .cursor/hooks/stop-check.mjs", "timeout": 240, "loop_limit": 2 }
    ]
  }
}
