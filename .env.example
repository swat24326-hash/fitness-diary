# Скопируйте в .env (локально) или задайте в Vercel → Settings → Environment Variables.
# После изменения на Vercel обязательно Redeploy (пересборка).
#
# Supabase → Project Settings → API:
#   VITE_SUPABASE_URL  = Project URL (https://xxxx.supabase.co)
#   VITE_SUPABASE_ANON_KEY = ключ «anon» / «anon public» (JWT, обычно начинается с eyJ…)
#
# ВАЖНО: sb_publishable_… НЕ подходит — REST и Auth вернут 401.
# Нужен именно «anon» / «anon public» (JWT, начинается с eyJ…):
#   Supabase → Project Settings → API → Project API keys → anon public
#   (или API Keys → Legacy → anon).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Локальный вход по логину (как на Vercel): скопируйте те же VITE_* из Vercel → Settings → Environment Variables.
# Либо в корне проекта: npx vercel dev  (поднимет сайт + /api/auth-sign-in).
# Только npm run dev без .env — демо-режим: логин admin или любой логин тренера без пароля в облаке.

# Только на Vercel (создание тренеров из админки через /api/create-trainer). НЕ добавляйте VITE_ — ключ не должен попасть в браузер.
# SUPABASE_SERVICE_ROLE_KEY=  (Supabase → Settings → API → service_role secret)
# SUPABASE_URL=               (опционально, если не хотите дублировать VITE_SUPABASE_URL)
# SUPABASE_ANON_KEY=          (опционально)

# GEMINI_API_KEY=              (Google AI Studio — для Edge gemini-analytics и /api/admin-data?action=gemini-analytics)
# GEMINI_MODEL=                (опционально: gemini-2.5-flash-lite | gemini-2.5-flash | gemini-3.1-flash-lite)
# Задайте в Supabase Edge Secrets и Vercel (не VITE_ — ключ только на сервере).

# Email админов (через запятую). Если REST к users обрывается — роль admin всё равно по email.
# VITE_ADMIN_EMAILS=admin@fit-city.ru
