# Скопируйте в .env и подставьте значения из Supabase:
# Dashboard → Settings → API → Project URL и anon public key
#
# ВАЖНО: переменные с префиксом VITE_ встраиваются в клиентский бандл при `npm run build`.
# На Netlify / Vercel / Cloudflare задайте их в настройках окружения и пересоберите сайт.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
