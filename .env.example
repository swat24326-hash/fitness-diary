# Скопируйте в .env (локально) или задайте в панели хостинга → Environment Variables.
# Сейчас деплой: Vercel; целевой переезд на РФ — docs/STRATEGY_SCALE_AND_RU_HOSTING.md (позже).
# После смены env обязательно Redeploy (пересборка).
#
# Supabase → Project Settings → API:
#   VITE_SUPABASE_URL  = Project URL (https://xxxx.supabase.co)
#   VITE_SUPABASE_ANON_KEY = ключ «anon» / «anon public» (JWT, обычно начинается с eyJ…)
#
# ВАЖНО: sb_publishable_… НЕ подходит — REST и Auth вернут 401.
# Нужен именно «anon» / «anon public» (JWT, начинается с eyJ…):
#   Supabase → Project Settings → API → Project API keys → anon public
#   (или API Keys → Legacy → anon).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Локальный вход по логину (как на Vercel): скопируйте те же VITE_* из Vercel → Settings → Environment Variables.
# Либо в корне проекта: npx vercel dev  (поднимет сайт + /api/auth-sign-in).
# Только npm run dev без .env — демо-режим: логин admin или любой логин тренера без пароля в облаке.

# Локально: куда проксировать /api при npm run dev (по умолчанию текущий prod).
# VITE_DEV_API_PROXY=https://fitness-diary-bice.vercel.app

# Smoke/QA против другого origin (staging / будущий РФ-хост):
# QA_ORIGIN=https://fitness-diary-bice.vercel.app

# Только на сервере API (создание тренеров через /api/create-trainer). НЕ добавляйте VITE_ — ключ не должен попасть в браузер.
# SUPABASE_SERVICE_ROLE_KEY=  (Supabase → Settings → API → service_role secret)
# SUPABASE_URL=               (опционально, если не хотите дублировать VITE_SUPABASE_URL)
# SUPABASE_ANON_KEY=          (опционально)

# GEMINI_API_KEY=              (Google AI Studio — admin-data?action=gemini-analytics и/или Edge)
# GEMINI_MODEL=                (опционально: gemini-2.5-flash-lite | gemini-2.5-flash | gemini-3.1-flash-lite)
# Задайте в секретах API-хоста и при необходимости Supabase Edge (не VITE_).

# Web Push — уведомления Планёрки (serverless env, не VITE_ для private):
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@fit-city.ru
# Опционально на фронте (тот же public): VITE_VAPID_PUBLIC_KEY=  — иначе клиент читает public с GET push-subscription

# Email админов (через запятую). Если REST к users обрывается — роль admin всё равно по email.
# VITE_ADMIN_EMAILS=admin@fit-city.ru
