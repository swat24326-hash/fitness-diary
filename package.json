{
  "name": "fitness-diary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:vercel": "vercel dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:migrate": "npx supabase db query --linked --file supabase/policies.sql",
    "db:migrate:sales": "node scripts/apply-club-sales-migration.mjs",
    "db:migrate:plan-matrix": "node scripts/apply-club-sales-plan-matrix.mjs",
    "db:migrate:scalability": "node scripts/apply-scalability-indexes.mjs",
    "db:migrate:iskra": "node scripts/apply-iskra-migrations.mjs",
    "db:migrate:homework": "node scripts/apply-homework-presets-migration.mjs",
    "db:migrate:pnk": "node scripts/apply-pnk-funnel-migration.mjs",
    "check:volume": "node scripts/check-data-volume.mjs",
    "gen:icons": "node scripts/generate-icons.mjs",
    "qa": "node scripts/agent-qa.mjs",
    "qa:local": "node scripts/agent-qa.mjs --skip-prod",
    "qa:roles": "node scripts/qa-roles-prod.mjs",
    "qa:roles:browser": "node scripts/qa-roles-browser.mjs",
    "qa:deep": "node scripts/deep-qa.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@supabase/supabase-js": "^2.49.1",
    "chart.js": "^4.4.7",
    "idb": "^8.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "sharp": "^0.34.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.2"
  }
}
